        int client_id PK
        int parent_client_id FK "nullable"
        text name
        text client_type
        text contact_email
        text qualification_note "nullable"
    }
    USER_ACCOUNT {
        int user_id PK
        text name
        text email UK
        text account_kind
        text staff_role "nullable"
        text status
    }
    CLIENT_MEMBERSHIP {
        int membership_id PK
